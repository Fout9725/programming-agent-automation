{
  "tests": [
    {
      "name": "Validate clean TypeScript code",
      "method": "POST",
      "path": "/",
      "body": {
        "files": {
          "App.tsx": "import React from 'react';\n\nconst App: React.FC = () => {\n  return <div>Hello</div>;\n};\n\nexport default App;"
        },
        "language": "typescript"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "passed": true,
        "errors": [],
        "security_score": 100
      }
    },
    {
      "name": "Detect any type usage",
      "method": "POST",
      "path": "/",
      "body": {
        "files": {
          "bad.ts": "const data: any = {};"
        },
        "language": "typescript"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "passed": false,
        "errors": "array"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Detect SQL injection",
      "method": "POST",
      "path": "/",
      "body": {
        "files": {
          "query.sql": "SELECT * FROM users WHERE id = + user_input"
        },
        "language": "sql"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "passed": false
      },
      "bodyMatcher": "partial"
    }
  ]
}
