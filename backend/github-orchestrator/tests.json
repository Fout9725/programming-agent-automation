{
  "tests": [
    {
      "name": "Autonomous commit",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "commit",
        "project_id": "test-project",
        "files": {
          "src/App.tsx": "import React from 'react'; export default App;"
        },
        "message": "AI: Initial commit"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "branch": "string",
        "files_committed": 1,
        "commit_sha": "string",
        "url": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Create PR",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "pr",
        "project_id": "test-project",
        "branch": "feature-branch",
        "title": "Add new feature",
        "description": "Added shopping cart functionality"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "pr_number": "number",
        "url": "string",
        "status": "open"
      },
      "bodyMatcher": "partial"
    }
  ]
}