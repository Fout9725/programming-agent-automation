{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET returns 405",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "POST generate empty",
      "method": "POST",
      "path": "/",
      "body": {"action": "generate", "spec": {"backend": {}}},
      "expectedStatus": 200
    },
    {
      "name": "POST unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400
    }
  ]
}
