{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET returns 405",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "POST deploy without files",
      "method": "POST",
      "path": "/",
      "body": {"action": "deploy", "files": {}, "project_name": "test"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST unknown action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown"},
      "expectedStatus": 400
    }
  ]
}
