{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "POST interpret without user_query",
      "method": "POST",
      "path": "/",
      "body": {"action": "interpret"},
      "expectedStatus": 400
    },
    {
      "name": "POST interpret ecommerce query",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "interpret",
        "user_query": "Создай интернет-магазин с корзиной и оплатой"
      },
      "expectedStatus": 200
    },
    {
      "name": "POST interpret landing query",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "interpret",
        "user_query": "Создай лендинг с формой обратной связи"
      },
      "expectedStatus": 200
    },
    {
      "name": "POST invalid action",
      "method": "POST",
      "path": "/",
      "body": {"action": "unknown_action"},
      "expectedStatus": 400
    }
  ]
}
